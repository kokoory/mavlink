  (wire (pts (xy 215.9 172.72) (xy 218.44 172.72)) (stroke (width 0) (type default)) (uuid 318d47be-1c24-43cd-bf16-6a5f262247b9))
  (text "Dual SX1280 (2x NiceRF LoRa1280) + STM32F103CBU6  -  ultra-compact 20 x 32 mm, 4-layer, double-sided" (at 25.4 22.86 0)
    (effects (font (size 2.0 2.0)) (justify left bottom))
    (uuid 7afd998c-b76d-4b62-8dc6-660f3f414d55)
  )
  (text "Radio A (top side) on SPI1, radio B (bottom side) on SPI2. Each radio: own NSS/BUSY/DIO1/NRESET, own U.FL." (at 25.4 30.48 0)
    (effects (font (size 1.5 1.5)) (justify left bottom))
    (uuid 55e36152-644a-46ce-bb9f-b519acac7f31)
  )
  (text "JP1/JP2: default 1-2 bridged = pin14 to GND (LoRa1280). Cut 1-2 and bridge 2-3 ONLY for LoRa1280-T (TCXO) modules." (at 25.4 35.56 0)
    (effects (font (size 1.5 1.5)) (justify left bottom))
    (uuid 172bf1be-de18-4bd2-9a58-b3065c421896)
  )
  (text "Host: J3 JST-SH 1.0mm  1=+5V 2=TX(PA9) 3=RX(PA10) 4=GND. USART1 is also the STM32 ROM bootloader (BOOT0 pad TP6)." (at 25.4 40.64 0)
    (effects (font (size 1.5 1.5)) (justify left bottom))
    (uuid cf5ba818-4256-43ec-ab54-f2a4da06d7bd)
  )
  (text "RADIO A  (SPI1, top)" (at 40.64 50.8 0)
    (effects (font (size 2.0 2.0)) (justify left bottom))
    (uuid faff5803-6afa-408e-91c7-cc23f3ac36f5)
  )
  (text "RADIO B  (SPI2, bottom)" (at 40.64 157.48 0)
    (effects (font (size 2.0 2.0)) (justify left bottom))
    (uuid 9270c591-5190-45a6-8865-f2bd1b493f79)
  )
  (text "MCU  STM32F103CBU6 (UFQFPN48, pin-compatible with the 48-pin STM32F103C8T6 family)" (at 198.12 76.2 0)
    (effects (font (size 1.5 1.5)) (justify left bottom))
    (uuid b8c2d6d1-db49-48fb-95fe-29d47a16bffe)
  )
  (text "POWER: 5V in -> AP2112K-3.3 (600 mA)" (at 297.18 30.48 0)
    (effects (font (size 2.0 2.0)) (justify left bottom))
    (uuid 646e4c71-d18a-4298-b150-3723faf36d5a)
  )
