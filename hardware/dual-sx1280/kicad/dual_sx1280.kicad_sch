  (wire (pts (xy 213.36 93.98) (xy 215.9 93.98)) (stroke (width 0) (type default)) (uuid c11a6fa7-04d1-4b2d-a9cb-08f801f40d57))
  (wire (pts (xy 215.9 93.98) (xy 218.44 93.98)) (stroke (width 0) (type default)) (uuid 62532c9b-18fb-4f42-9fde-45700f0ec93d))
  (wire (pts (xy 218.44 93.98) (xy 220.98 93.98)) (stroke (width 0) (type default)) (uuid f0bb0b56-394b-4c18-ba8c-a83999a5c046))
